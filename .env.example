# Copy to .env and fill in. Never commit .env.

# --- Database ---
DATABASE_URL=postgres://heinzel:heinzel@localhost:5432/heinzel

# --- LLM gateway (any OpenAI-compatible endpoint) ---
# Requesty EU gateway (Frankfurt). Use https://router.requesty.ai/v1 for the global endpoint.
LLM_BASE_URL=https://router.eu.requesty.ai/v1
LLM_API_KEY=
# Model ids exactly as shown in your gateway's model library. Pick EU-region deployments for full EU residency.
# The agent model does the real work (tool use); the triage model only decides "speak or not" and should be small and cheap.
# Recommended (Requesty EU catalog, Oct 2026): Claude Sonnet 5.5 on Bedrock for the agent, Claude Haiku 5.5 on Bedrock for triage.
# Copy the exact ids from the Requesty Model Library; Bedrock EU ids carry a region suffix, e.g. bedrock/claude-sonnet-5@eu-central-1.
# EU-provider-only alternative: Mistral Large 4 (agent) + Mistral Small (triage).
LLM_MODEL_AGENT=
LLM_MODEL_TRIAGE=
# Optional strong model for hard tasks (recommended: Claude Opus 5.5 on Bedrock EU). Leave empty to disable.
# The agent model escalates on its own via the `escalate` tool; triage can route "complex" questions; people can force it with "!deep <question>".
LLM_MODEL_HEAVY=
HEAVY_DAILY_LIMIT=20
AGENT_MAX_STEPS_HEAVY=16
# "requesty" tags every call with channel/purpose metadata for Requesty's cost tracking; use "none" for other gateways.
LLM_METADATA_STYLE=requesty
# none | json_object | json_schema — "none" works with every model.
LLM_STRUCTURED_OUTPUT=none

# --- Slack (Socket Mode; see README) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# --- Microsoft Teams (see docs/TEAMS.md) ---
# Azure Bot registration (single tenant). Teams posts to https://<public host>/api/messages.
# TEAMS_APP_ID=
# TEAMS_APP_PASSWORD=
# TEAMS_TENANT_ID=
# TEAMS_PORT=3978
# Local testing with the Microsoft 365 Agents Playground (no Azure, no tenant). Never in production.
# TEAMS_PLAYGROUND=true

# --- Admin UI (see docs/ADMIN.md) ---
# Local: a development sign-in button (only from this machine).
# ADMIN_DEV_LOGIN=true
# Production: single sign-on via OpenID Connect (Entra ID shown); people need the app role Heinzel.Admin or Heinzel.Viewer.
# ADMIN_PUBLIC_URL=https://heinzel-admin.example.com
# ADMIN_OIDC_ISSUER=https://login.microsoftonline.com/<tenant id>/v2.0
# ADMIN_OIDC_CLIENT_ID=
# ADMIN_OIDC_CLIENT_SECRET=
# ADMIN_PORT=3080
# ADMIN_HOST=127.0.0.1

# Settings the admin UI may not change (comma-separated, "*" = all), for configuration as code.
# LOCKED_SETTINGS=
# Encrypts tokens of MCP servers added in the admin UI: openssl rand -base64 32
# SECRETS_KEY=

# --- External tools (see docs/TOOLS.md) ---
# Path to the MCP server config (cp mcp.example.json mcp.json). Leave empty for no external tools.
MCP_CONFIG=
# Built-in tool to read public web pages (private/internal addresses are always refused).
WEB_FETCH=true
# Tool results (MCP, web pages) longer than this are cut.
TOOL_RESULT_MAX_CHARS=16000
# Secrets referenced as ${VAR} in mcp.json:
# GITLAB_URL=https://gitlab.example.com
# GITLAB_MCP_TOKEN=glpat-...   # fine-grained PAT with "MCP tool: Execute"
# ATLASSIAN_BASIC_AUTH=        # base64 of "email:api-token"
# Self-hosted web search (docker compose --profile tools): openssl rand -hex 32
# SEARXNG_SECRET=

# --- Coding sessions (see docs/CODING.md) ---
CODING_ENABLED=false
# GITLAB_URL=https://gitlab.example.com
# CODING_GIT_TOKEN=glpat-...   # project/group access token, role Developer, scope write_repository
# CODING_REPOSITORIES=team/*
# CODING_IMAGE=heinzel-coder:latest
# CODING_DOCKER_NETWORK=heinzel-coding
# CODING_PROXY_URL=http://egress-proxy:3128
# EGRESS_ALLOW=router.eu.requesty.ai,gitlab.example.com
# CODING_MODEL=               # default: LLM_MODEL_HEAVY, else LLM_MODEL_AGENT
# CODING_TIMEOUT_MIN=45
# CODING_MAX_RUNNING=2
# DOCKER_HOST=unix:///var/run/docker.sock

# --- Operations ---
# /healthz and /readyz for probes; 0 disables.
# HEALTH_PORT=8081

# --- Behaviour (defaults shown) ---
BOT_NAME=Heinzel
LOG_LEVEL=info
WORKER_CONCURRENCY=4
AMBIENT_DEFAULT=false
AMBIENT_DAILY_LIMIT=5
AMBIENT_THREAD_COOLDOWN_MIN=30
AMBIENT_MIN_CONFIDENCE=0.75
CONTEXT_MESSAGES=30
AGENT_MAX_STEPS=8
# Days to keep stored message copies; 0 = keep forever. Memories are kept either way.
EVENTS_RETENTION_DAYS=0
