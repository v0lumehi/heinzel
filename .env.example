# Copy to .env and fill in. Never commit .env.

# --- Database ---
DATABASE_URL=postgres://heinzel:heinzel@localhost:5432/heinzel

# --- LLM gateway (any OpenAI-compatible endpoint) ---
# Requesty EU gateway (Frankfurt). Use https://router.requesty.ai/v1 for the global endpoint.
LLM_BASE_URL=https://router.eu.requesty.ai/v1
LLM_API_KEY=
# Model ids exactly as shown in your gateway's model library. Pick EU-region deployments for full EU residency.
# The agent model does the real work (tool use); the triage model only decides "speak or not" and should be small and cheap.
# Recommended (Requesty EU catalog, Oct 2026): Claude Sonnet 5.5 on Bedrock for the agent, Claude Haiku 5.5 on Bedrock for triage.
# Copy the exact ids from the Requesty Model Library; Bedrock EU ids carry a region suffix, e.g. bedrock/claude-sonnet-5@eu-central-1.
# EU-provider-only alternative: Mistral Large 4 (agent) + Mistral Small (triage).
LLM_MODEL_AGENT=
LLM_MODEL_TRIAGE=
# "requesty" tags every call with channel/purpose metadata for Requesty's cost tracking; use "none" for other gateways.
LLM_METADATA_STYLE=requesty
# none | json_object | json_schema — "none" works with every model.
LLM_STRUCTURED_OUTPUT=none

# --- Slack (Socket Mode; see README) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# --- Behaviour (defaults shown) ---
BOT_NAME=Heinzel
LOG_LEVEL=info
WORKER_CONCURRENCY=4
AMBIENT_DEFAULT=false
AMBIENT_DAILY_LIMIT=5
AMBIENT_THREAD_COOLDOWN_MIN=30
AMBIENT_MIN_CONFIDENCE=0.75
CONTEXT_MESSAGES=30
AGENT_MAX_STEPS=8
