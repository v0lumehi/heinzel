{
  "name": "heinzel",
  "version": "0.1.1",
  "description": "Open-source, self-hosted, proactive AI teammate for Slack and Microsoft Teams. LLM-agnostic via any OpenAI-compatible gateway (e.g. Requesty).",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:web": "pnpm --filter heinzel-web dev",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json && cp -r src/db/migrations dist/db/ && pnpm build:web",
    "build:web": "pnpm --filter heinzel-web build",
    "typecheck": "tsc --noEmit && pnpm --filter heinzel-web typecheck",
    "migrate": "tsx src/db/migrate.ts",
    "mcp": "tsx src/mcp/cli.ts",
    "teams:package": "tsx src/adapters/teams/package-cli.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.5",
    "@microsoft/teams.api": "2.1.0",
    "@microsoft/teams.apps": "2.1.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@slack/bolt": "^5.1.0",
    "fastify": "5.12.5",
    "node-html-markdown": "^2.0.0",
    "openai": "^7.35.0",
    "openid-client": "6.8.8",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "undici": "^8.12.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "5.0.3",
    "fast-check": "4.10.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.28.0"
}
